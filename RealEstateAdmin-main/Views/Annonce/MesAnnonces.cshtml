@model IEnumerable<RealEstateAdmin.Models.Annonce>

@{
    ViewData["Title"] = "Mes annonces";
}

<div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h1 class="text-gradient">
            <i class="bi bi-megaphone"></i> Mes annonces
        </h1>
        <a asp-controller="Annonce" asp-action="Wizard" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Publier un bien
        </a>
    </div>

    @if (!Model.Any())
    {
        <div class="text-center py-5">
            <i class="bi bi-megaphone" style="font-size:4rem;color:#ccc;"></i>
            <h4 class="mt-3 text-muted">Vous n'avez pas encore soumis d'annonce</h4>
            <p class="text-muted">Publiez votre premier bien en quelques minutes.</p>
            <a asp-controller="Annonce" asp-action="Wizard" class="btn btn-primary mt-2">
                <i class="bi bi-plus-circle"></i> Publier un bien
            </a>
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var annonce in Model)
            {
                var (badgeClass, icon, label) = annonce.Statut switch
                {
                    "Approuvée" => ("bg-success",   "bi-check-circle-fill", "Approuvée — publiée sur le shop"),
                    "Refusée"   => ("bg-danger",    "bi-x-circle-fill",     "Refusée"),
                    _           => ("bg-warning text-dark", "bi-clock-fill","En attente de validation")
                };

                var photoUrl = annonce.Photos.FirstOrDefault()?.Url;

                <div class="col-md-6 col-xl-4">
                    <div class="card h-100 shadow-sm">
                        @if (!string.IsNullOrWhiteSpace(photoUrl))
                        {
                            <img src="@photoUrl" class="card-img-top" style="height:200px;object-fit:cover;" alt="Photo" />
                        }
                        else
                        {
                            <div class="card-img-top bg-light d-flex align-items-center justify-content-center" style="height:200px;">
                                <i class="bi bi-image text-muted" style="font-size:3rem;"></i>
                            </div>
                        }

                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-3">
                                <div>
                                    @if (!string.IsNullOrWhiteSpace(annonce.NatureBien))
                                    {
                                        <span class="badge bg-primary me-1">@annonce.NatureBien</span>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(annonce.EtatBien))
                                    {
                                        var etatColor = annonce.EtatBien switch {
                                            "Rénové"   => "bg-success",
                                            "Bon état" => "bg-info text-dark",
                                            _          => "bg-secondary"
                                        };
                                        <span class="badge @etatColor">@annonce.EtatBien</span>
                                    }
                                </div>
                                <span class="badge @badgeClass">
                                    <i class="bi @icon me-1"></i>@annonce.Statut
                                </span>
                            </div>

                            <h6 class="card-title">
                                @annonce.SurfaceM2 m²
                                @if (annonce.NbChambres > 0) { <span>· @annonce.NbChambres ch.</span> }
                                · @annonce.Delegation, @annonce.Gouvernorat
                            </h6>

                            <p class="fw-bold text-primary mb-2">@annonce.PrixTnd.ToString("N0") TND</p>

                            @if (annonce.Description != null)
                            {
                                <p class="small text-muted text-truncate mb-2" title="@annonce.Description">
                                    @annonce.Description
                                </p>
                            }

                            <!-- Message selon statut -->
                            @if (annonce.Statut == "En attente")
                            {
                                <div class="alert alert-warning py-2 mb-0 small">
                                    <i class="bi bi-clock me-1"></i>
                                    Votre annonce est en cours de vérification par notre équipe.
                                </div>
                            }
                            else if (annonce.Statut == "Approuvée" && annonce.BienImmobilierId != null)
                            {
                                <div class="alert alert-success py-2 mb-0 small">
                                    <i class="bi bi-check-circle me-1"></i>
                                    Votre bien est publié sur le shop.
                                    <a asp-controller="Shop" asp-action="Details" asp-route-id="@annonce.BienImmobilierId" class="alert-link ms-1">
                                        Voir l'annonce <i class="bi bi-box-arrow-up-right"></i>
                                    </a>
                                </div>
                            }
                            else if (annonce.Statut == "Refusée")
                            {
                                <div class="alert alert-danger py-2 mb-0 small">
                                    <i class="bi bi-x-circle me-1"></i>
                                    Votre annonce n'a pas été retenue. Vous pouvez en soumettre une nouvelle.
                                </div>
                            }
                        </div>

                        <div class="card-footer text-muted small">
                            <i class="bi bi-calendar3"></i> Soumise le @annonce.CreatedAt.ToString("dd/MM/yyyy")
                            · <i class="bi bi-images"></i> @annonce.Photos.Count photo(s)
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
