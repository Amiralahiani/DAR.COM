@model RealEstateAdmin.Models.ClientProfile?

@{
    ViewData["Title"] = "Profil ML Client";
    var mlAvailable = (bool)(ViewBag.MlAvailable ?? false);
    var userName    = (string)(ViewBag.UserName ?? "Client");
    var userEmail   = (string)(ViewBag.UserEmail ?? "");
    var behavior    = ViewBag.Behavior as RealEstateAdmin.Services.UserBehaviorData;
}

<style>
    .ml-card {
        background: linear-gradient(135deg, #0f172a, #1e293b);
        border-radius: 20px;
        border: 1px solid #2d3f55;
        color: #e2e8f0;
    }
    .ml-card-header {
        background: linear-gradient(135deg, #0c1b22, #1a2f42);
        border-radius: 20px 20px 0 0;
        border-bottom: 1px solid #2d3f55;
        padding: 1.5rem;
    }
    /* Override Bootstrap text-muted sur fond sombre */
    .ml-card .text-muted,
    .ml-section .text-muted { color: #94a3b8 !important; }
    .ml-card .bi.text-muted  { color: #7890a8 !important; }
    .ml-card small           { color: #94a3b8; }

    .score-ring {
        width: 110px; height: 110px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        flex-direction: column; font-size: 2rem; font-weight: 800; border: 4px solid;
    }
    .score-ring.hot   { border-color: #ef4444; color: #ef4444; background: #ef444415; }
    .score-ring.warm  { border-color: #f59e0b; color: #f59e0b; background: #f59e0b15; }
    .score-ring.cold  { border-color: #94a3b8; color: #94a3b8; background: #64748b15; }

    .metric-row {
        display: flex; align-items: center; gap: 0.75rem;
        padding: 0.6rem 0; border-bottom: 1px solid #2d3f5580;
    }
    .metric-row:last-child { border-bottom: none; }
    .metric-label { color: #94a3b8; font-size: 0.8rem; text-transform: uppercase; letter-spacing: .05em; min-width: 140px; }
    .metric-value { color: #e2e8f0; font-weight: 600; font-size: 0.95rem; }
    .metric-bar-wrap { flex: 1; background: #1e3a50; border-radius: 6px; height: 6px; overflow: hidden; }
    .metric-bar { height: 100%; border-radius: 6px; background: linear-gradient(90deg, #3b82f6, #b8872f); }

    .intent-badge {
        display: inline-block; padding: .35em .75em;
        border-radius: 999px; font-size: .8rem; font-weight: 700; letter-spacing: .04em;
    }
    .intent-achat     { background: #ef444425; color: #ff8080; border: 1px solid #ef444450; }
    .intent-location  { background: #f59e0b25; color: #fbbf24; border: 1px solid #f59e0b50; }
    .intent-curiosite { background: #64748b25; color: #94a3b8; border: 1px solid #64748b50; }

    .signal-chip {
        display: inline-flex; align-items: center; gap: .35rem;
        background: #1e3a50; border: 1px solid #2d4f6a;
        border-radius: 8px; padding: .3rem .65rem;
        font-size: .8rem; color: #94a3b8;
    }
    .signal-chip span { color: #e2e8f0; font-weight: 600; }
    .signal-chip .bi  { color: #7890a8; }

    .ml-section {
        background: #0f172a; border: 1px solid #2d3f55;
        border-radius: 16px; padding: 1.5rem;
    }
    .ml-section .reco-card small { color: #a0aec0; }

    .unavailable-banner {
        background: #1e293b; border: 1px dashed #475569;
        border-radius: 16px; padding: 3rem;
        text-align: center; color: #94a3b8;
    }
    .unavailable-banner h4 { color: #cbd5e1; }
    .unavailable-banner code { color: #d6a547; background: #1e3a50; padding: 2px 6px; border-radius: 4px; }
</style>

<div class="container py-4">

    <div class="d-flex align-items-center gap-3 mb-4">
        <a asp-action="Index" class="btn btn-sm btn-outline-secondary">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <h1 class="mb-0 text-gradient" style="font-size:1.6rem;">
                <i class="bi bi-robot"></i> Profil ML — @userName
            </h1>
            <small class="text-muted">@userEmail</small>
        </div>
    </div>

    @if (!mlAvailable)
    {
        <div class="unavailable-banner">
            <i class="bi bi-plug" style="font-size:2.5rem;"></i>
            <h4 class="mt-3">ML Engine indisponible</h4>
            <p class="mb-3">Le moteur d'analyse est hors ligne. Lancez-le avec <code>python main.py</code>.</p>
            <a asp-action="Index" class="btn btn-outline-secondary btn-sm">Retour à la liste</a>
        </div>
    }
    else if (Model is null)
    {
        <div class="unavailable-banner">
            <i class="bi bi-exclamation-circle" style="font-size:2.5rem;"></i>
            <h4 class="mt-3">Profil non calculable</h4>
            <p class="mb-0">Données insuffisantes pour ce client.</p>
        </div>
    }
    else
    {
        var ringClass    = Model.LeadScorePct >= 70 ? "hot" : Model.LeadScorePct >= 40 ? "warm" : "cold";
        var intentClass  = Model.PredictedIntent.Contains("ACHAT") ? "intent-achat"
                         : Model.PredictedIntent.Contains("LOCATION") ? "intent-location"
                         : "intent-curiosite";
        var budgetBar    = Math.Min((double)Model.PredictedBudget / 2_000_000.0 * 100, 100);
        var scoreBar     = Model.LeadScorePct;

        <div class="row g-4">

            @* Colonne gauche : score + persona *@
            <div class="col-md-5">
                <div class="ml-card h-100">
                    <div class="ml-card-header d-flex align-items-center justify-content-between">
                        <div>
                            <div class="text-muted small text-uppercase" style="letter-spacing:.08em;">Segment client</div>
                            <div class="fw-bold" style="color:#d6a547;font-size:1.1rem;">@Model.PersonaSegment</div>
                        </div>
                        <span class="intent-badge @intentClass">@Model.PredictedIntent</span>
                    </div>
                    <div class="p-4 d-flex flex-column align-items-center gap-3">
                        <div class="score-ring @ringClass">
                            <span>@((int)Model.LeadScorePct)</span>
                            <small style="font-size:.7rem;font-weight:500;">%</small>
                        </div>
                        <div class="text-center">
                            <div class="fw-bold" style="color:#d6a547;">Lead Score</div>
                            <span class="@Model.LeadScoreBadgeClass" style="font-size:.85rem;">@Model.LeadScoreLabel</span>
                        </div>
                        <div class="w-100">
                            <div class="d-flex justify-content-between mb-1">
                                <small class="text-muted">Probabilité d'achat</small>
                                <small style="color:#d6a547;">@Model.LeadScorePct %</small>
                            </div>
                            <div class="metric-bar-wrap">
                                <div class="metric-bar" style="width:@scoreBar%;"></div>
                            </div>
                        </div>
                        <div class="text-muted small text-center">
                            Cluster #@Model.ClusterId &nbsp;·&nbsp;
                            Mis à jour @Model.LastUpdated.ToString("dd/MM/yyyy HH:mm")
                        </div>
                    </div>
                </div>
            </div>

            @* Colonne droite : métriques *@
            <div class="col-md-7">
                <div class="ml-card h-100">
                    <div class="ml-card-header">
                        <div class="text-muted small text-uppercase" style="letter-spacing:.08em;">Analyse financière & comportementale</div>
                    </div>
                    <div class="p-4">

                        @* Budget *@
                        <div class="mb-4">
                            <div class="d-flex justify-content-between align-items-end mb-1">
                                <span class="text-muted small text-uppercase" style="letter-spacing:.05em;">Budget estimé</span>
                                <span style="color:#d6a547;font-size:1.5rem;font-weight:800;">
                                    @Model.PredictedBudget.ToString("N0") DT
                                </span>
                            </div>
                            <div class="metric-bar-wrap" style="height:8px;">
                                <div class="metric-bar" style="width:@budgetBar%;"></div>
                            </div>
                        </div>

                        @* Signaux comportementaux (depuis la DB) *@
                        @if (behavior is not null)
                        {
                            <div class="mb-4">
                                <div class="text-muted small text-uppercase mb-2" style="letter-spacing:.05em;">Signaux observés</div>
                                <div class="d-flex flex-wrap gap-2">
                                    <div class="signal-chip">
                                        <i class="bi bi-eye"></i> Visites <span>@behavior.PropertyViewsCount</span>
                                    </div>
                                    <div class="signal-chip">
                                        <i class="bi bi-heart"></i> Favoris <span>@behavior.FavoritesCount</span>
                                    </div>
                                    <div class="signal-chip">
                                        <i class="bi bi-telephone"></i> Contacts <span>@behavior.ContactAgentClicks</span>
                                    </div>
                                    <div class="signal-chip">
                                        <i class="bi bi-rulers"></i> Surface moy. <span>@((int)behavior.AvgSurfaceViewed) m²</span>
                                    </div>
                                    <div class="signal-chip">
                                        <i class="bi bi-cash-stack"></i> Prix moyen vu <span>@(((decimal)behavior.AvgPriceViewed).ToString("N0")) DT</span>
                                    </div>
                                </div>
                            </div>
                        }

                        @* Métriques détaillées *@
                        <div>
                            <div class="metric-row">
                                <i class="bi bi-person-badge text-muted"></i>
                                <span class="metric-label">Persona</span>
                                <span class="metric-value">@Model.PersonaSegment</span>
                            </div>
                            <div class="metric-row">
                                <i class="bi bi-lightning-charge text-muted"></i>
                                <span class="metric-label">Intention</span>
                                <span class="intent-badge @intentClass">@Model.PredictedIntent</span>
                            </div>
                            <div class="metric-row">
                                <i class="bi bi-graph-up text-muted"></i>
                                <span class="metric-label">Lead Score</span>
                                <span class="metric-value">@Model.LeadScorePct %</span>
                                <div class="metric-bar-wrap">
                                    <div class="metric-bar" style="width:@scoreBar%;"></div>
                                </div>
                            </div>
                            <div class="metric-row">
                                <i class="bi bi-currency-dollar text-muted"></i>
                                <span class="metric-label">Budget estimé</span>
                                <span class="metric-value">@Model.PredictedBudget.ToString("N0") DT</span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        @* Recommandations actions commerciales *@
        <div class="mt-4 ml-section">
            <h6 style="color:#d6a547;" class="mb-3 ml-section"><i class="bi bi-lightbulb"></i> Recommandations commerciales</h6>
            <div class="row g-3">
                @if (Model.LeadScorePct >= 70)
                {
                    <div class="col-md-4">
                        <div class="p-3 rounded-2" style="background:#ef444415;border:1px solid #ef444440;">
                            <i class="bi bi-telephone-fill" style="color:#ef4444;"></i>
                            <strong class="d-block mt-1" style="color:#ef4444;">Appel prioritaire</strong>
                            <small class="text-muted">Lead très chaud — contacter dans les 24h</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-2" style="background:#3b82f615;border:1px solid #3b82f640;">
                            <i class="bi bi-house-check-fill" style="color:#3b82f6;"></i>
                            <strong class="d-block mt-1" style="color:#3b82f6;">Proposer une visite</strong>
                            <small class="text-muted">Budget estimé @Model.PredictedBudget.ToString("N0") DT</small>
                        </div>
                    </div>
                    <div class="col-md-4">
                        <div class="p-3 rounded-2" style="background:#d6a54715;border:1px solid #d6a54740;">
                            <i class="bi bi-file-earmark-text-fill" style="color:#d6a547;"></i>
                            <strong class="d-block mt-1" style="color:#d6a547;">Préparer une offre</strong>
                            <small class="text-muted">Segment : @Model.PersonaSegment</small>
                        </div>
                    </div>
                }
                else if (Model.LeadScorePct >= 40)
                {
                    <div class="col-md-6">
                        <div class="p-3 rounded-2" style="background:#f59e0b15;border:1px solid #f59e0b40;">
                            <i class="bi bi-envelope-fill" style="color:#f59e0b;"></i>
                            <strong class="d-block mt-1" style="color:#f59e0b;">Relance par email</strong>
                            <small class="text-muted">Lead tiède — envoyer des biens dans sa fourchette</small>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="p-3 rounded-2" style="background:#3b82f615;border:1px solid #3b82f640;">
                            <i class="bi bi-search" style="color:#3b82f6;"></i>
                            <strong class="d-block mt-1" style="color:#3b82f6;">Affiner la recherche</strong>
                            <small class="text-muted">Surface préférée ~@((int)(behavior?.AvgSurfaceViewed ?? 100)) m² | Budget ~@Model.PredictedBudget.ToString("N0") DT</small>
                        </div>
                    </div>
                }
                else
                {
                    <div class="col-12">
                        <div class="p-3 rounded-2" style="background:#64748b15;border:1px solid #64748b40;">
                            <i class="bi bi-eye" style="color:#64748b;"></i>
                            <strong class="d-block mt-1" style="color:#94a3b8;">Phase d'exploration</strong>
                            <small class="text-muted">Client en observation — ne pas presser, envoyer du contenu informatif</small>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
</div>
