@{
    var isSolde = ViewBag.SoldeOnly == true;
    ViewData["Title"] = isSolde ? "Carte des biens en solde" : "Carte des biens";
}

<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" />

<div class="container-fluid px-0">
    <div class="d-flex justify-content-between align-items-center px-4 py-3">
        <h1 class="text-gradient mb-0">
            <i class="bi bi-map"></i> @(isSolde ? "Carte des biens en solde" : "Carte des biens disponibles")
        </h1>
        <a asp-action="@(isSolde ? "Solde" : "Index")" class="btn btn-outline-secondary">
            <i class="bi bi-list-ul"></i> Retour à la liste
        </a>
    </div>

    <div id="map" style="height: calc(100vh - 140px); width: 100%;"></div>
</div>

@section Scripts {
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
    <script>
        const biens = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model,
            new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }));

        const map = L.map('map').setView([33.8869, 9.5375], 6);

        L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png', {
            attribution: '© OpenStreetMap contributors'
        }).addTo(map);

        function buildPopup(b) {
            const prix    = new Intl.NumberFormat('fr-TN').format(b.prix);
            const surface = b.surface ? `${b.surface} m²` : '';
            const nature  = b.natureBien || '';
            const discount = b.discountPercent > 0
                ? `<span style="background:#dc3545;color:#fff;padding:2px 6px;border-radius:4px;font-size:.75rem;">-${b.discountPercent}%</span>` : '';
            const imgHtml = b.imageUrl
                ? `<img src="${b.imageUrl}" style="width:100%;height:120px;object-fit:cover;border-radius:6px;margin-bottom:8px;" />`
                : '';
            return `<div style="min-width:200px;max-width:240px;">
                ${imgHtml}
                <div style="font-weight:700;font-size:.95rem;margin-bottom:4px;">${b.titre}</div>
                ${nature ? `<div style="font-size:.8rem;color:#6b7280;margin-bottom:4px;">${nature}</div>` : ''}
                <div style="font-size:.9rem;color:#d6a547;font-weight:700;margin-bottom:4px;">${prix} DT ${discount}</div>
                ${surface ? `<div style="font-size:.8rem;color:#6b7280;margin-bottom:6px;">📐 ${surface}</div>` : ''}
                ${b.adresse ? `<div style="font-size:.8rem;color:#6b7280;margin-bottom:8px;">📍 ${b.adresse}</div>` : ''}
                <a href="/Shop/Details/${b.id}" style="display:block;background:#1a6b5e;color:#fff;text-align:center;padding:6px;border-radius:6px;text-decoration:none;font-size:.85rem;">
                    Voir le bien →
                </a></div>`;
        }

        async function geocodeAddress(address) {
            try {
                const url = `https://nominatim.openstreetmap.org/search?format=json&limit=1&q=${encodeURIComponent(address + ', Tunisie')}`;
                const res = await fetch(url);
                const arr = await res.json();
                if (Array.isArray(arr) && arr.length > 0) {
                    const lat = parseFloat(arr[0].lat);
                    const lon = parseFloat(arr[0].lon);
                    if (Number.isFinite(lat) && Number.isFinite(lon)) return { lat, lon };
                }
            } catch(e) {}
            return null;
        }

        const markers = [];

        (async () => {
            for (const b of biens) {
                let lat = b.latitude != null ? parseFloat(b.latitude) : NaN;
                let lng = b.longitude != null ? parseFloat(b.longitude) : NaN;

                if (!Number.isFinite(lat) || !Number.isFinite(lng)) {
                    if (b.adresse) {
                        const g = await geocodeAddress(b.adresse);
                        if (g) { lat = g.lat; lng = g.lon; }
                    }
                }

                if (Number.isFinite(lat) && Number.isFinite(lng)) {
                    const m = L.marker([lat, lng]).addTo(map).bindPopup(buildPopup(b));
                    markers.push([lat, lng]);
                }
            }

            if (markers.length > 0) {
                map.fitBounds(L.latLngBounds(markers), { padding: [40, 40] });
            }
        })();
    </script>
}
